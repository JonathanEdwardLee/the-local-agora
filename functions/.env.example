# Local Agora Functions — sanitized environment template
# Copy to functions/.env for local spike runs. Never commit real values.

# Required for live Keryx Pass A / Pass B spike scripts
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides (defaults match ADR-006)
KERYX_DISCOVERY_MODEL=gemini-3.5-flash
KERYX_NORMALIZATION_MODEL=gemini-3.5-flash

# Optional compatibility override note (leave empty unless required)
# KERYX_MODEL_OVERRIDE_REASON=
