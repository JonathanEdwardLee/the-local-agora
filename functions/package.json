{
  "name": "the-local-agora-functions",
  "version": "0.1.0",
  "private": true,
  "description": "Protected Keryx backend for The Local Agora (Firebase Cloud Functions 2nd gen).",
  "main": "lib/index.js",
  "engines": {
    "node": "22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "keryx:spike": "tsx scripts/run_keryx_spike.ts",
    "keryx:smoke": "tsx scripts/smoke_grounded_search.ts",
    "clean": "rimraf lib"
  },
  "dependencies": {
    "@google/genai": "^2.11.0",
    "firebase-admin": "^13.6.0",
    "firebase-functions": "^6.6.0",
    "undici": "^7.28.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
